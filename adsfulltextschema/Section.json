{
  "title": "Section",
  "description": "Recursive object that holds the extracted properties of a body, appendix, or abstract section",
  "type": "object",
  "properties": {
    "atext": {
      "type": "string"
    },
    "bibRefs": {
      "type": "array",
      "description": "Array of BibRef.json objects",
      "items": {
        "$ref": "./BibRef.json"
      }
    },
    "datalinks": {
      "type": "array",
      "description": "Array of DataLink.json objects",
      "items": {
        "$ref": "https://github.com/adsabs/ingest_data_model/tree/main/adsingestschema/DataLink.json"
      }
    },
    "footnotes": {
      "type": "array",
      "description": "Array of Footnote.json objects",
      "items": {
        "$ref": "./Footnote.json"
      }
    },
    "figures": {
      "type": "array",
      "description": "Array of Figure.json objects",
      "items": {
        "$ref": "./Figure.json"
      }
    },
    "id": {
      "type": "string",
      "description": "Publisher ID for section"
    },
    "label": {
      "type": "string",
      "description": "Label for section"
    },
    "language": {
      "type": "string",
      "description": "Language of section, if stated"
    },
    "sectionTitle": {
      "type": "string"
    },
    "subsections": {
      "type": "array",
      "description": "Array of Section.json objects (recursive def)",
      "items": {
        "$ref": "#"
      }
    },
    "tables": {
      "type": "array",
      "description": "Array of Table.json objects",
      "items": {
        "$ref": "./Table.json"
      }
    }
  }
}
